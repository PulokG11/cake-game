{
  "name": "cakegame",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "admin:password": "node --env-file=.env.local scripts/admin-password.mjs",
    "api:build": "esbuild functions/api/index.ts --bundle --platform=node --format=esm --target=node24 --minify --legal-comments=none --outfile=dist-function/index.mjs && node scripts/pack-function.mjs",
    "api:dev": "npm run api:build && node --env-file=.env.local scripts/serve-api.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0",
    "@neondatabase/serverless": "^1.2.1"
  }
}
