# Copy to .env.local. Never commit real values.

# Neon connection string (Neon console → Connect). Used by the local API server and the db/admin scripts.
DATABASE_URL=postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require

# Where the site sends API calls. Locally: the API from `npm run api:dev`.
NEXT_PUBLIC_API_URL=http://localhost:8788
